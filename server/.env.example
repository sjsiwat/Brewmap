# MongoDB Atlas connection string (Atlas -> Connect -> Drivers)
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/brewmap?retryWrites=true&w=majority
PORT=4000
# Origin of the Next.js app, allowed by CORS (credentials enabled for the JWT cookie)
WEB_ORIGIN=http://localhost:3000
# Signs the login JWT. Use a long random value, e.g. `openssl rand -base64 48`
JWT_SECRET=change-me
# Proxies in front of this server, for req.ip (Render: 1). Leave empty locally.
TRUST_PROXY=
# Shared with web/ (same value): lets the web app's /api proxy pass the visitor's
# IP for rate limiting. Leave empty locally; set a random value in production.
PROXY_SECRET=
# API docs at /api/docs: on by default except when NODE_ENV=production.
# Set true/false to force it either way.
SWAGGER=
