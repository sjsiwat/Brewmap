# MongoDB Atlas connection string (Atlas -> Connect -> Drivers)
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/brewmap?retryWrites=true&w=majority
PORT=4000
# Origin of the Next.js app, allowed by CORS (credentials enabled for the JWT cookie)
WEB_ORIGIN=http://localhost:3000
# Signs the login JWT. Use a long random value, e.g. `openssl rand -base64 48`
JWT_SECRET=change-me
