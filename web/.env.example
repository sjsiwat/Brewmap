# Base URL of the BrewMap API (server/). Server-side only: server components call it
# directly, and next.config.ts proxies the browser's /api/* requests to it.
API_URL=http://localhost:4000/api

# Same value as PROXY_SECRET in server/.env. Lets the /api proxy forward the
# visitor's IP for the login rate limit. Only set it where the platform sets
# x-real-ip / x-forwarded-for itself (Vercel) - leave empty for local `next dev/start`.
PROXY_SECRET=
